# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model used by every agent
CLAUDE_MODEL=claude-sonnet-5

# Optional: if set, every /api request must send this in the X-App-Password header.
# The frontend prompts for it once and remembers it in localStorage.
APP_PASSWORD=

# Port for the Express server
PORT=3000
